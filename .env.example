# Copy this file to .env and fill in the values. .env is git-ignored.
# Leave both sources' credentials empty to run with demo data.
#
# Wrap passwords and tokens in single quotes, e.g. DESIGNHUB_PASSWORD='p@ss$#1'.
# Single quotes keep characters like $ and # exactly as typed, both for
# `npm start` and for Docker Compose.

# --- App ---------------------------------------------------------------
PORT=3000
# 127.0.0.1 = only this computer can open the page. Use 0.0.0.0 to share it
# on the network (set APP_PASSWORD too: the page shows student names).
# With Docker Compose, HOST and PORT choose where the container is published.
HOST=127.0.0.1
# Optional HTTP basic auth for the PrintBuster page itself.
APP_USERNAME=admin
APP_PASSWORD=''
# Time zone the Design Hub agenda is displayed in.
TIMEZONE=America/Chicago
# true = always show demo data, false = always use live data,
# empty = demo data only when no credentials are configured.
DEMO_MODE=
# Seconds to reuse fetched data before asking the upstream sites again.
CACHE_SECONDS=60

# --- Design Hub / Studio Manager ----------------------------------------
DESIGNHUB_BASE_URL=https://designhub-manager.unl.edu
# A local (non-SSO) Studio Manager account that is an admin with the
# "See Agenda" permission. Logs in through the /login/ form.
DESIGNHUB_USERNAME=
DESIGNHUB_PASSWORD=''
# Alternative for SSO-only accounts: the rack.session cookie from a browser
# signed in to the Design Hub. README: "Finding the Design Hub session cookie".
# Example: DESIGNHUB_COOKIE='rack.session=BAh7B0kiD3Nlc3Npb25f...%3D%3D--3f2a9c'
DESIGNHUB_COOKIE=''
# Optional: only fetch one "Reservation Category" (the dropdown's value).
DESIGNHUB_WORKSHOP_CATEGORY=

# --- Bambu Lab cloud ----------------------------------------------------
BAMBU_REGION=global
BAMBU_EMAIL=
BAMBU_PASSWORD=''
# Optional: a token instead of email/password (the "token" cookie from
# makerworld.com). README: "Finding a Bambu access token".
BAMBU_ACCESS_TOKEN=''
# Where the token from an email-code / 2FA login is saved between restarts.
BAMBU_TOKEN_CACHE=data/bambu-token.json
# Bambu only keeps about a day of print history, so PrintBuster checks it in
# the background and saves every print to the print log. 0 = off.
BAMBU_POLL_MINUTES=15
PRINT_LOG_PATH=data/print-log.jsonl
# Every agenda day read for the usage page is saved here, so past
# reservations don't depend on Design Hub. Contains member names.
RESERVATION_LOG_PATH=data/reservations.json
# The latest calculated filament usage of every print.
USAGE_LOG_PATH=data/usage.json

# --- Matching -----------------------------------------------------------
# A print may start this many minutes before, or run this many minutes past,
# a reservation and still count as reserved.
MATCH_GRACE_MINUTES=15
# Flag a print as "large" above these (Bambu's figures are slice estimates).
# 0 turns a flag off.
FLAG_WEIGHT_GRAMS=200
FLAG_DURATION_HOURS=12
# Bambu printer name (or serial number) = Design Hub "Model" column.
# Only needed when the names differ, e.g.:
# PRINTER_MAP=X1C-01=Ada,01S00C123456789=Archimedes
PRINTER_MAP=
# Row order on the waterfall (defaults to the design-hub-waterfall list).
PRINTER_ORDER=
